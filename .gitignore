node_modules/
dist/
python/__pycache__/

# Tauri sidecar binaries (auto-downloaded by build.rs)
src-tauri/binaries/ffmpeg-*

# Tauri 构建生成的 schema（capabilities 引用的 gen/schemas）
src-tauri/gen/

# Python bundle: keep bare Python runtime (.exe/.dll/.zip) in git,
# exclude pip-installed packages (generated by bundle-python.bat)
src-tauri/python-bundle/Lib/
src-tauri/python-bundle/Scripts/
src-tauri/python-bundle/get-pip.py
src-tauri/python-bundle/__pycache__/

# Bundled models (auto-downloaded by build.rs, ~77MB)
src-tauri/models/*.bin
src-tauri/models/*.onnx

# Rust build artifacts
src-tauri/target/

# IDE
.idea/
*.swp
*.swo
